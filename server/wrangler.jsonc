// myPod activation server (CLA-128). No secrets here: Jason adds them as Worker secrets.
{
  "name": "mypod-activation",
  "main": "src/index.ts",
  // The activation page (card BX): static files at /activate/, with their headers in public/_headers.
  "assets": { "directory": "./public" },
  "compatibility_date": "2026-11-01",
  "d1_databases": [
    { "binding": "DB", "database_name": "mypod-activation", "database_id": "45674323-433f-468e-be42-149642c17893" }
  ],
  // The app's API on its own host, and the page at getmypod.app/activate/. Every other path on
  // getmypod.app stays with the Launch website. /activate (no slash) goes to /activate/ (the
  // assets' trailing-slash rule); a path with no file under the route gets the Worker's 404.
  "routes": [
    { "pattern": "api.getmypod.app", "custom_domain": true },
    { "pattern": "getmypod.app/activate*", "zone_name": "getmypod.app" }
  ],
  // The beta cap (accounts; 25, CLA-172), the Mac limit per account, and link mails a day (Resend free: 100).
  // MAIL_HOUR and MAIL_DAY_EACH: link mails per address and per device, an hour and a day.
  // SWAPS and SWAP_DAYS (CLA-133): a 3rd Mac replaces the least used one, at most SWAPS times in SWAP_DAYS days.
  // PAGE_ORIGIN: where the page is (path /activate/). It sets the mail link, CORS and the bot check.
  // Secrets that Jason adds with `wrangler secret put`: RESEND_KEY, ALERT_TO, TURNSTILE_SECRET.
  "vars": { "CAP": "25", "MACS": "2", "SWAPS": "3", "SWAP_DAYS": "30", "MAIL_DAY": "95", "MAIL_HOUR": "3", "MAIL_DAY_EACH": "5", "PAGE_ORIGIN": "https://getmypod.app" },
  "observability": { "enabled": false }
}
